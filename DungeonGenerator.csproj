<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Sign in with ChatGPT currently uses the preview Responses API adapters. -->
        <NoWarn>$(NoWarn);OPENAI001;MAAI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.22.0" />
      <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.22.0" />
      <!-- Keep this aligned with Microsoft.Agents.AI.OpenAI 1.22.0. -->
      <PackageReference Include="OpenAI" Version="2.13.0" />
      <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
